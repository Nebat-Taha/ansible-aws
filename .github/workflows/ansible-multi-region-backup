name: Ansible Multi-Region Backup CI/CD Pipeline

on:
  workflow_dispatch:
  # schedule:
  #   - cron: '0 2 * * *' # Example: Run at 2:00 AM daily

jobs:
  execute-backups:
    runs-on: ubuntu-latest
    permissions:
      id-token: write
      contents: read
    strategy:
      matrix:
        aws_region: ["us-east-1", "eu-central-1"]
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
          aws-region: ${{ matrix.aws_region }}

      - name: Set up Ansible and Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.x"

      - name: Install Dependencies
        run: |
          pip install ansible boto3 botocore
          ansible-galaxy collection install community.aws
      
      - name: Configure SSH Multiplexing (5-minute window)
        run: |
          mkdir -p ~/.ssh
          cat <<EOF >> ~/.ssh/config
          Host *
            StrictHostKeyChecking no
            ControlMaster auto
            ControlPath ~/.ssh/ansible-%r@%h:%p
            ControlPersist 5m
          EOF
          chmod 600 ~/.ssh/config

      - name: Generate Ephemeral SSH Key
        run: |
          ssh-keygen -t rsa -f ~/.ssh/id_rsa -N "" -q
          chmod 600 ~/.ssh/id_rsa

      - name: Inject SSH Keys (Instance Connect)
        run: |
          # Note: Filter matches the 'Project' tag we verified in your Terraform plan
          INSTANCE_IDS=$(aws ec2 describe-instances \
            --filters "Name=tag:Project,Values=ansible-aws" "Name=instance-state-name,Values=running" \
            --query "Reservations[*].Instances[*].InstanceId" \
            --output text)

          for ID in $INSTANCE_IDS; do
            aws ec2-instance-connect send-ssh-public-key \
              --instance-id $ID \
              --instance-os-user ubuntu \
              --ssh-public-key file://~/.ssh/id_rsa.pub
          done
          sleep 5

      - name: Calculate Target Variables
        id: set_vars
        run: |
          RAW_REGION="${{ matrix.aws_region }}"
          CLEAN_REGION="${RAW_REGION//-/_}"
          echo "CLEAN_REGION=$CLEAN_REGION" >> $GITHUB_OUTPUT

      - name: Run Backup Playbook
        run: |
          ansible-playbook -i ansible/inventory/aws_ec2.yml \
            ansible/playbooks/backup_data.yml \
            -e "target_region=${{ steps.set_vars.outputs.CLEAN_REGION }}" \
            --limit "region_${{ steps.set_vars.outputs.CLEAN_REGION }}"
        env:
          ANSIBLE_CONFIG: ansible/ansible.cfg
          AWS_REGION: ${{ matrix.aws_region }}
          BACKBLAZE_APPLICATION_KEY_ID: ${{ secrets.BACKBLAZE_APPLICATION_KEY_ID }}
          BACKBLAZE_APPLICATION_KEY: ${{ secrets.BACKBLAZE_APPLICATION_KEY }}